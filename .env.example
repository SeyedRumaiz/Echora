# GEMINI_API_KEY: Required for all Gemini API calls (chat, reflection synthesis,
# single-entry analysis). For local development, copy this file to .env and set
# a real key from Google AI Studio.
#
# In production this is never read from a .env file: Cloud Run injects it as a
# secret reference resolved from Google Cloud Secret Manager at container
# startup, so the key is never baked into the image, the client bundle, or
# source control.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Optional. Cloud Run sets this automatically at deploy time and the
# server reads it via process.env.PORT; it defaults to 3000 for local dev.
# You do not need to set this yourself.
